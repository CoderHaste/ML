import matplotlib.pyplot as plt
from sklearn.datasets import load_iris
from sklearn.cluster import KMeans

X = load_iris().data # unlabelled data (labels ignored)
ks = range(1, 9)
wcss = [KMeans(n_clusters=k, n_init=10, random_state=0).fit(X).inertia_ for k in ks]
for k, w in zip(ks, wcss): print(f"k={k} WCSS={w:.1f}")

plt.plot(ks, wcss, "o-"); plt.xlabel("k"); plt.ylabel("WCSS"); plt.title("Elbow method")
plt.show()
