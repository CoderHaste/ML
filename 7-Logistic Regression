from sklearn.datasets import load_breast_cancer
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import confusion_matrix, accuracy_score

X, y = load_breast_cancer(return_X_y=True) # binary: 0 = malignant, 1 = benign
X_tr, X_te, y_tr, y_te = train_test_split(X, y, test_size=0.2, stratify=y, random_state=42)
sc = StandardScaler().fit(X_tr)

m = LogisticRegression(max_iter=1000).fit(sc.transform(X_tr), y_tr)
p = m.predict(sc.transform(X_te))
print(confusion_matrix(y_te, p)) # [[TN FP], [FN TP]]
print("Accuracy:", round(accuracy_score(y_te, p), 4))
